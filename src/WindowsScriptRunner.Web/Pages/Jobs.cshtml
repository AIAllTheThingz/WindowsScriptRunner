@page
@model WindowsScriptRunner.Web.Pages.JobsModel
@{
    ViewData["Title"] = "Jobs";
}

<h1>Jobs</h1>
<div class="scaffold-card">
    <h2>Local Host Inventory</h2>
    <p>Request the reviewed, parameterless inventory package for the local Worker host. This request is ReadOnly and DryRun-only.</p>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <form method="post">
        <button class="btn btn-primary" type="submit">Request inventory</button>
    </form>
</div>
