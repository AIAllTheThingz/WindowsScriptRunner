@using Microsoft.AspNetCore.Authorization
@using WindowsScriptRunner.Web.Security
@inject IAuthorizationService AuthorizationService
@{
    var canReadReports = (await AuthorizationService.AuthorizeAsync(User, AuthorizationPolicies.ReportReader)).Succeeded;
    var canReviewApprovals = (await AuthorizationService.AuthorizeAsync(User, AuthorizationPolicies.Approver)).Succeeded;
    var canAdminister = (await AuthorizationService.AuthorizeAsync(User, AuthorizationPolicies.Administrator)).Succeeded;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Windows Script Runner</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WindowsScriptRunner.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark app-nav border-bottom mb-4">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">Windows Script Runner</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link" asp-page="/Index">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Jobs">Jobs</a></li>
                        @if (canReadReports)
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Reports/LocalHostInventory/Index">Reports</a></li>
                        }
                        @if (canReviewApprovals)
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Approvals/Index">Approvals</a></li>
                        }
                        @if (canAdminister)
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Administration">Administration</a></li>
                        }
                        <li class="nav-item"><a class="nav-link" asp-page="/Account/SignOut">Sign out</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 Windows Script Runner &mdash; early development scaffold; not production-ready.
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
