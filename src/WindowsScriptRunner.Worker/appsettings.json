{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Persistence": {
    "CommandTimeoutSeconds": 30,
    "RetryCount": 3,
    "RetryDelaySeconds": 5,
    "ApplyMigrationsOnStartup": false,
    "EnableDetailedErrors": false
  },
  "Worker": {
    "HeartbeatIntervalSeconds": 30
  }
}
